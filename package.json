{
  "name": "saweeg-home",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "generate": "node --experimental-strip-types scripts/generate-pages.ts",
    "dev": "node --experimental-strip-types scripts/generate-pages.ts && vite",
    "images:optimize:menu": "node scripts/process-menu-product-images.mjs",
    "test:menu": "node --experimental-strip-types --test tests/menu-official-data.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "node --experimental-strip-types scripts/generate-pages.ts && tsc --noEmit && vite build && node scripts/verify-unified-build.mjs",
    "verify:build": "node scripts/verify-unified-build.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "sharp": "0.35.4",
    "typescript": "5.8.3",
    "vite": "7.3.5"
  }
}
